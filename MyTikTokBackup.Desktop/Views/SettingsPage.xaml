<Page
    x:Class="MyTikTokBackup.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyTikTokBackup.Desktop.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Margin="12">
            <StackPanel Margin="0,12,0,12">
                <TextBlock 
                Text="Downloads folder" 
                Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock 
                Text="{x:Bind ViewModel.DownloadsFolderPath, Mode=OneWay}"/>
                <Button
                Content="Change"
                Command="{x:Bind ViewModel.ChooseDownloadsFolderCommand}"/>
            </StackPanel>

            <StackPanel Margin="0,12,0,12" Spacing="4">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="AI labels" />
                <TextBlock TextWrapping="Wrap">
                    Suggests your categories for videos, based on descriptions, hashtags and video frames.
                    Everything runs locally; models are downloaded once (<Run Text="{x:Bind ViewModel.AiModelsSize}" />).
                </TextBlock>
                <ToggleSwitch
                    AutomationProperties.AutomationId="AiLabelsToggle"
                    Header="Automatic AI labels"
                    IsOn="{x:Bind ViewModel.AiLabelsEnabled, Mode=TwoWay}" />
                <TextBlock
                    AutomationProperties.AutomationId="AiLabelsStatus"
                    Text="{x:Bind ViewModel.AiStatusText, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <ProgressBar
                    MaxWidth="400"
                    HorizontalAlignment="Left"
                    IsIndeterminate="{x:Bind ViewModel.IsAiProgressIndeterminate, Mode=OneWay}"
                    Value="{x:Bind ViewModel.AiProgress, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsAiLabelingRunning, Mode=OneWay}"
                    Width="400" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        AutomationProperties.AutomationId="RecomputeAiLabelsButton"
                        Command="{x:Bind ViewModel.RecomputeAiLabelsCommand}"
                        Content="Recompute now"
                        IsEnabled="{x:Bind ViewModel.AiLabelsEnabled, Mode=OneWay}" />
                    <Button
                        AutomationProperties.AutomationId="CancelAiLabelingButton"
                        Command="{x:Bind ViewModel.CancelAiLabelingCommand}"
                        Content="Cancel"
                        IsEnabled="{x:Bind ViewModel.IsAiLabelingRunning, Mode=OneWay}" />
                    <Button
                        AutomationProperties.AutomationId="ClearRejectedAiLabelsButton"
                        Command="{x:Bind ViewModel.ClearRejectedAiLabelsCommand}"
                        Content="Clear rejected"
                        ToolTipService.ToolTip="Allow AI to suggest again the labels you rejected or categories you removed from videos" />
                    <Button
                        AutomationProperties.AutomationId="DeleteAiModelsButton"
                        Command="{x:Bind ViewModel.DeleteAiModelsCommand}"
                        Content="Delete models"
                        IsEnabled="{x:Bind ViewModel.IsAiLabelingIdle, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,12,0,12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">
                Help:
                </TextBlock>
                <TextBlock>
                * scroll page to load more videos, application automatically finds videos to download
                    <LineBreak/>
                * only new videos are downloaded
                    <LineBreak/>
                * you need to log in to search users
                    <LineBreak/>
                * if you log in you can add all users you follow to bookmarks
                </TextBlock>
            </StackPanel>

            <StackPanel Margin="0,12,0,12">
                <TextBlock Text="Version" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock>
                    <Run Text="{x:Bind ViewModel.AppName}"/>
                    <Run Text="{x:Bind ViewModel.AppVersion}"/>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
