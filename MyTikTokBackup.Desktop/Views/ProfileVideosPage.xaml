<Page
    x:Class="MyTikTokBackup.Desktop.Views.ProfileVideosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MyTikTokBackup.Desktop.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MyTikTokBackup.Desktop.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Pop in, hold, fade out  -->
        <Storyboard x:Name="PlayPauseIndicatorStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayPauseIndicator" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayPauseIndicatorScale" Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="1.25" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayPauseIndicatorScale" Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="1.25" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="{x:Bind VM.UserUniqueId, Mode=OneWay}" />
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button
                        AutomationProperties.AutomationId="PostedButton"
                        Click="Posted_Click"
                        Content="Posted" />
                    <Button
                        AutomationProperties.AutomationId="LikedButton"
                        Click="Liked_Click"
                        Content="Liked" />
                    <Button
                        AutomationProperties.AutomationId="BookmarkedButton"
                        Click="Bookmarked_Click"
                        Content="Bookmarked" />
                </StackPanel>
                <AutoSuggestBox
                    AutomationProperties.AutomationId="VideoSearchBox"
                    PlaceholderText="Search"
                    QueryIcon="Find"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    Text="{x:Bind VM.Query, Mode=TwoWay}"
                    TextChanged="SearchBox_TextChanged" />
                <controls:CategoriesFilterControl
                    AddRequested="CategoriesFilter_AddRequested"
                    Categories="{x:Bind VM.Categories}"
                    DeleteRequested="CategoriesFilter_DeleteRequested"
                    FilterChanged="CategoriesFilter_FilterChanged"
                    RenameRequested="CategoriesFilter_RenameRequested" />
            </StackPanel>
            <controls:VideoCategoriesControl
                Grid.Row="2"
                Categories="{x:Bind VM.Categories}"
                CategoryToggled="VideoCategories_CategoryToggled"
                IsEnabled="{x:Bind VM.HasSelectedVideo, Mode=OneWay}" />
            <Grid Grid.Row="1">
                <ListView
                    IsItemClickEnabled="True"
                    ItemsSource="{x:Bind VM.Videos}"
                    SelectionChanged="Videos_SelectionChanged"
                    SelectionMode="Single"
                    Visibility="Visible">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Video.Description}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
        <Pivot
            x:Name="videoPivot"
            Grid.Column="1"
            SelectionChanged="Pivot_SelectionChanged">
            <PivotItem Header="Video">
                <Grid x:Name="MediaPlayerElementContainer" SizeChanged="MediaPlayerElementContainer_SizeChanged">
                    <!--  Sized in code to the video's aspect ratio so overlays sit on the video, like on TikTok  -->
                    <Grid
                        x:Name="VideoHost"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="VideoSurface"
                        AutomationProperties.Name="Video. Click to play or pause."
                        Background="Black"
                        CornerRadius="8"
                        Tapped="VideoHost_Tapped"
                        Visibility="{x:Bind local:ProfileVideosPage.BoolToVisibility(VM.HasSelectedVideo), Mode=OneWay}">
                        <MediaPlayerElement
                            x:Name="mediaPlayerElement"
                            AreTransportControlsEnabled="False"
                            Stretch="Uniform"
                            Visibility="{x:Bind local:ProfileVideosPage.InvertBoolToVisibility(VM.SelectedVideo.IsImagePost), Mode=OneWay}" />

                        <!--  Photo post: images are loaded in code-behind (ShowImagesAsync)  -->
                        <FlipView
                            x:Name="ImagesFlipView"
                            AutomationProperties.AutomationId="PhotoPostFlipView"
                            AutomationProperties.Name="Photo post images"
                            Background="Black"
                            SelectionChanged="ImagesFlipView_SelectionChanged"
                            Visibility="{x:Bind local:ProfileVideosPage.BoolToVisibility(VM.SelectedVideo.IsImagePost), Mode=OneWay}">
                            <FlipView.ItemTemplate>
                                <DataTemplate x:DataType="BitmapImage">
                                    <Image Source="{x:Bind}" Stretch="Uniform" />
                                </DataTemplate>
                            </FlipView.ItemTemplate>
                        </FlipView>

                        <!--  Play / pause feedback shown briefly after a click  -->
                        <Border
                            x:Name="PlayPauseIndicator"
                            Width="80"
                            Height="80"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#66000000"
                            CornerRadius="40"
                            IsHitTestVisible="False"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PlayPauseIndicatorScale" />
                            </Border.RenderTransform>
                            <Viewbox Width="34" Height="34">
                                <SymbolIcon
                                    x:Name="PlayPauseIcon"
                                    Foreground="White"
                                    Symbol="Play" />
                            </Viewbox>
                        </Border>

                        <!--  Author, description and progress bar over a bottom scrim  -->
                        <StackPanel Padding="0,40,0,0" VerticalAlignment="Bottom">
                            <StackPanel.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00000000" />
                                    <GradientStop Offset="1" Color="#A6000000" />
                                </LinearGradientBrush>
                            </StackPanel.Background>
                            <!--  Dark pill keeps the pips readable on bright images  -->
                            <Border
                                Margin="0,0,0,8"
                                Padding="6,0"
                                HorizontalAlignment="Center"
                                Background="#66000000"
                                CornerRadius="12"
                                Visibility="{x:Bind local:ProfileVideosPage.BoolToVisibility(VM.SelectedVideo.IsImagePost), Mode=OneWay}">
                                <PipsPager
                                    x:Name="ImagesPipsPager"
                                    AutomationProperties.AutomationId="PhotoPostPipsPager"
                                    AutomationProperties.Name="Photo post pages"
                                    RequestedTheme="Dark"
                                    SelectedIndexChanged="ImagesPipsPager_SelectedIndexChanged" />
                            </Border>
                            <StackPanel
                                Padding="14,0,14,8"
                                IsHitTestVisible="False"
                                Spacing="4">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{x:Bind VM.SelectedVideo.Video.Author.Nickname, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="White"
                                    MaxLines="3"
                                    Text="{x:Bind VM.SelectedVideo.Video.Description, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid
                                x:Name="ProgressArea"
                                Height="14"
                                AutomationProperties.AutomationId="VideoProgress"
                                AutomationProperties.Name="Video progress. Click to seek."
                                Background="Transparent"
                                PointerCaptureLost="ProgressArea_PointerCaptureLost"
                                PointerMoved="ProgressArea_PointerMoved"
                                PointerPressed="ProgressArea_PointerPressed"
                                PointerReleased="ProgressArea_PointerReleased"
                                Tapped="ProgressArea_Tapped"
                                Visibility="{x:Bind local:ProfileVideosPage.InvertBoolToVisibility(VM.SelectedVideo.IsImagePost), Mode=OneWay}">
                                <Rectangle
                                    Height="3"
                                    VerticalAlignment="Bottom"
                                    Fill="#4DFFFFFF" />
                                <Rectangle
                                    Height="3"
                                    VerticalAlignment="Bottom"
                                    Fill="White"
                                    RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform x:Name="ProgressFillScale" ScaleX="0" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </PivotItem>
            <PivotItem Header="Web">
                <WebView2
                    x:Name="webView"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </PivotItem>
            <PivotItem Header="Info">
                <ScrollViewer>
                <StackPanel Orientation="Vertical" Spacing="8">
                    <controls:LabelValueControl Label="Video Id" Value="{x:Bind VM.SelectedVideo.Video.VideoId, Mode=OneWay}" />
                    <controls:LabelValueControl Label="Author Nickname" Value="{x:Bind VM.SelectedVideo.Video.Author.Nickname, Mode=OneWay}" />
                    <controls:LabelValueControl Label="Author Signature" Value="{x:Bind VM.SelectedVideo.Video.Author.Signature, Mode=OneWay}" />
                    <controls:LabelValueControl Label="Author Unique Id" Value="{x:Bind VM.SelectedVideo.Video.Author.UniqueId, Mode=OneWay}" />
                    <controls:LabelValueControl Label="Description" Value="{x:Bind VM.SelectedVideo.Video.Description, Mode=OneWay}" />
                    <controls:LabelValueControl Label="Comment" Value="{x:Bind VM.SelectedVideo.Video.Stats.CommentCount, Mode=OneWay}" />
                    <controls:LabelValueControl Label="Share" Value="{x:Bind VM.SelectedVideo.Video.Stats.ShareCount, Mode=OneWay}" />
                    <controls:LabelValueControl Label="Play" Value="{x:Bind VM.SelectedVideo.Video.Stats.PlayCount, Mode=OneWay}" />
                    <controls:LabelValueControl Label="Digg" Value="{x:Bind VM.SelectedVideo.Video.Stats.DiggCount, Mode=OneWay}" />
                    <controls:LabelValueControl Label="Music Title" Value="{x:Bind VM.SelectedVideo.Video.Music.Title, Mode=OneWay}" />
                    <controls:LabelValueControl Label="Music Album" Value="{x:Bind VM.SelectedVideo.Video.Music.Album, Mode=OneWay}" />
                    <controls:LabelValueControl Label="Music Author" Value="{x:Bind VM.SelectedVideo.Video.Music.AuthorName, Mode=OneWay}" />
                </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>

    </Grid>
</Page>
